{
  "name": "myvideostation",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "node scripts/ensure-tools.mjs --quiet && node scripts/air.mjs",
    "dev:api": "node scripts/air.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "pnpm --filter myvideostation-web build",
    "typecheck": "pnpm --filter myvideostation-web typecheck",
    "test": "go test ./...",
    "lint": "node scripts/lint.mjs",
    "clean": "node scripts/clean.mjs",
    "docker": "node scripts/docker.mjs",
    "bootstrap": "node scripts/ensure-tools.mjs"
  }
}
